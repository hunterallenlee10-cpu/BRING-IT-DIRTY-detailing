# Supabase (leave empty to run in local demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAILS=

# Demo mode owner login (used only when Supabase is not configured)
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=bring-it-dirty
DEMO_SESSION_SECRET=change-me-to-a-long-random-string

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_ALERT_PHONE=

# n8n webhook (optional): every lead is POSTed here
N8N_WEBHOOK_URL=

# Vercel Cron auth for /api/cron/reminders
CRON_SECRET=

# Upstash rate limit (optional; in-memory LRU otherwise)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
